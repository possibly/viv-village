// Tavern social interactions for Viv Village
// Each evening, villagers at the tavern perform these actions.
//
// Entity view properties:
//   age, health, hunger, socialNeed, wealth, reputation  — numbers
//   personality_thrifty                                   — number 0-1
//   is_single                                             — bool (not married)
//   has_gossip                                            — bool
//   friendships[uid]          — number 0-100, keyed by entity ID string
//   romanticAffection[uid]    — number 0-100, keyed by entity ID string
//   quarreled[uid]            — bool, keyed by entity ID string
//   romanticInterest          — uid string or null
//
// KEY: use @other.id (the UID string) as the lookup key into plain-object dicts,
// because @other alone evaluates to the full entity view, not a string.


// ---------------------------------------------------------------------------
// Template: all tavern actions share these roles and base conditions
// ---------------------------------------------------------------------------

template action tavern-action:
    gloss: "Something happens at the tavern"
    importance: 1
    roles:
        @actor:
            as: initiator
        @other:
            as: recipient
    conditions:
        @actor.age >= 16
        @other.age >= 16


// ---------------------------------------------------------------------------
// CHAT — light conversation; mild friendship boost for both
// ---------------------------------------------------------------------------

action chat from tavern-action:
    gloss: "@actor and @other share conversation over drinks"
    report: '{@actor.name} ({@actor.occupation}) falls into easy conversation with {@other.name}.'
    importance: 1
    join conditions:
        @actor.socialNeed > 20
    join effects:
        @actor.friendships[@other.id] += 5
        @other.friendships[@actor.id] += 5
        @actor.socialNeed -= 15


// ---------------------------------------------------------------------------
// DEEP TALK — heartfelt exchange; requires existing friendship
// ---------------------------------------------------------------------------

action deep-talk from tavern-action:
    gloss: "@actor opens up to @other about life"
    report: '{@actor.name} and {@other.name} lose track of time talking. Something real passed between them.'
    importance: 2
    join conditions:
        @actor.friendships[@other.id] >= 18
        @actor.socialNeed > 30
    join effects:
        @actor.friendships[@other.id] += 15
        @other.friendships[@actor.id] += 15
        @actor.socialNeed -= 25


// ---------------------------------------------------------------------------
// FLIRT — a romantic spark; one-sided affection builds
// ---------------------------------------------------------------------------

action flirt from tavern-action:
    gloss: "@actor flirts with @other"
    report: '{@actor.name} catches the eye of {@other.name} and holds it a moment too long.'
    importance: 2
    join conditions:
        @actor.age >= 18
        @other.age >= 18
        @actor.romanticAffection[@other.id] < 60
    join effects:
        @actor.romanticAffection[@other.id] += 15
        @actor.friendships[@other.id] += 3


// ---------------------------------------------------------------------------
// DECLARE AFFECTION — bolder move; requires built-up affection
// ---------------------------------------------------------------------------

action declare-affection from tavern-action:
    gloss: "@actor confesses feelings for @other"
    report: '{@actor.name} leans close and quietly tells {@other.name} how much they mean to them.'
    importance: 3
    join conditions:
        @actor.age >= 18
        @other.age >= 18
        @actor.romanticAffection[@other.id] >= 15
        @actor.is_single == true
    join effects:
        @actor.romanticAffection[@other.id] += 25
        @actor.romanticInterest = @other.id
        @other.romanticAffection[@actor.id] += 8
        @actor.friendships[@other.id] += 10
    embargoes:
        embargo:
            roles: @actor, @other
            time: 10 hours


// ---------------------------------------------------------------------------
// BUY A ROUND — generosity boosts reputation and recipient friendship
// ---------------------------------------------------------------------------

action buy-a-round from tavern-action:
    gloss: "@actor buys a round for @other"
    report: '{@actor.name} slides a cup across the bar to {@other.name} with a grin.'
    importance: 2
    join conditions:
        @actor.wealth >= 3
        @actor.personality_thrifty < 0.7
    join effects:
        @actor.wealth -= 2
        @actor.reputation += 5
        @other.friendships[@actor.id] += 10


// ---------------------------------------------------------------------------
// SHARE GOSSIP — whispers a rumor; mild friendship, consumes gossip
// ---------------------------------------------------------------------------

action share-gossip from tavern-action:
    gloss: "@actor whispers gossip to @other"
    report: '{@actor.name} leans in and whispers something to {@other.name}, who raises an eyebrow.'
    importance: 2
    join conditions:
        @actor.has_gossip == true
        @actor.socialNeed > 25
    join effects:
        @actor.friendships[@other.id] += 5
        @other.friendships[@actor.id] += 5
        @actor.has_gossip = false
        @actor.socialNeed -= 10


// ---------------------------------------------------------------------------
// CONFIDE — shares a personal worry; deepens trust
// ---------------------------------------------------------------------------

action confide from tavern-action:
    gloss: "@actor confides a worry to @other"
    report: '{@actor.name} stares into their cup and quietly confides in {@other.name}.'
    importance: 3
    join conditions:
        @actor.friendships[@other.id] >= 20
        @actor.health < 70
    join effects:
        @actor.friendships[@other.id] += 20
        @other.friendships[@actor.id] += 15
        @actor.socialNeed -= 20


// ---------------------------------------------------------------------------
// SHARE JOB TIP — mentions work opportunities in their trade
// ---------------------------------------------------------------------------

action share-job-tip from tavern-action:
    gloss: "@actor tells @other about a job opening"
    report: '{@actor.name} mentions to {@other.name} that there is work going spare in the {@actor.occupation} trade.'
    importance: 3
    join conditions:
        @actor.friendships[@other.id] >= 15
        @actor.reputation >= 30
    join effects:
        @actor.reputation += 5
        @actor.friendships[@other.id] += 10
        @other.friendships[@actor.id] += 5


// ---------------------------------------------------------------------------
// OFFER MENTORSHIP — experienced villager teaches younger one their craft
// ---------------------------------------------------------------------------

action offer-mentorship from tavern-action:
    gloss: "@actor offers to mentor @other in their craft"
    report: '{@actor.name} tells {@other.name} to come work alongside them for a while.'
    importance: 4
    join conditions:
        @actor.age >= 30
        @other.age < 25
        @actor.friendships[@other.id] >= 25
        @actor.reputation >= 45
    join effects:
        @actor.friendships[@other.id] += 30
        @other.friendships[@actor.id] += 25
        @actor.reputation += 10
    embargoes:
        embargo:
            roles: @actor, @other
            time: 30 hours


// ---------------------------------------------------------------------------
// TOAST THE VILLAGE — public act; big reputation boost, small wealth cost
// ---------------------------------------------------------------------------

action toast-the-village from tavern-action:
    gloss: "@actor raises a toast to the village"
    report: '{@actor.name} stands up and raises a cup: "To the village — long may she stand!"'
    importance: 3
    join conditions:
        @actor.wealth >= 4
        @actor.reputation >= 40
    join effects:
        @actor.wealth -= 3
        @actor.reputation += 10
    embargoes:
        embargo:
            roles: @actor
            time: 48 hours


// ---------------------------------------------------------------------------
// QUARREL — tempers flare when hungry and with a near-stranger
// ---------------------------------------------------------------------------

action quarrel from tavern-action:
    gloss: "@actor and @other get into an argument"
    report: '{@actor.name} and {@other.name} exchange heated words. The tavern goes quiet.'
    importance: 3
    join conditions:
        20%
        @actor.hunger > 45
        @actor.friendships[@other.id] < 10
    join effects:
        @actor.friendships[@other.id] -= 15
        @other.friendships[@actor.id] -= 15
        @actor.quarreled[@other.id] = true
        @other.quarreled[@actor.id] = true
    embargoes:
        embargo:
            roles: @actor, @other
            time: 6 hours


// ---------------------------------------------------------------------------
// RECONCILE — two former quarrelers make peace
// ---------------------------------------------------------------------------

action reconcile from tavern-action:
    gloss: "@actor makes peace with @other"
    report: '{@actor.name} extends a hand to {@other.name}. Old grievances set aside — at least for tonight.'
    importance: 3
    join conditions:
        @actor.quarreled[@other.id] == true
        @actor.friendships[@other.id] >= 5
    join effects:
        @actor.friendships[@other.id] += 20
        @other.friendships[@actor.id] += 20
        @actor.quarreled[@other.id] = false
        @other.quarreled[@actor.id] = false
    embargoes:
        embargo:
            roles: @actor, @other
            time: 24 hours


// ---------------------------------------------------------------------------
// ACTION SELECTOR — picks an evening action for each tavern-goer
// ---------------------------------------------------------------------------

action-selector pick-evening-action:
    roles:
        @villager:
            as: initiator
    target with weights:
        (10) chat:
            with partial:
                @actor: @villager
        (3) deep-talk:
            with partial:
                @actor: @villager
        (4) flirt:
            with partial:
                @actor: @villager
        (3) declare-affection:
            with partial:
                @actor: @villager
        (4) buy-a-round:
            with partial:
                @actor: @villager
        (3) share-gossip:
            with partial:
                @actor: @villager
        (3) confide:
            with partial:
                @actor: @villager
        (4) share-job-tip:
            with partial:
                @actor: @villager
        (2) offer-mentorship:
            with partial:
                @actor: @villager
        (2) toast-the-village:
            with partial:
                @actor: @villager
        (1) quarrel:
            with partial:
                @actor: @villager
        (2) reconcile:
            with partial:
                @actor: @villager
